# Server
PORT=3500
NODE_ENV=production
CLIENT_URL=https://webmail.repod.online

# JWT
JWT_SECRET=change-this-to-random-64-char-string
JWT_REFRESH_SECRET=change-this-to-another-random-64-char-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# MongoDB (ByteMail app data)
MONGODB_URI=mongodb://username:password@localhost:27017/bytemail

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# WildDuck
WILDDUCK_MONGO_URI=mongodb://localhost:27017/wildduck
WILDDUCK_API_URL=http://127.0.0.1:8080
WILDDUCK_ACCESS_TOKEN=your-wildduck-access-token
MAIL_FROM="ByteMail <noreply@repod.online>"

# VAPID (PWA Push Notifications) - generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=admin@repod.online
