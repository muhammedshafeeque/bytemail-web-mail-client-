# Server
PORT=3500
NODE_ENV=production
CLIENT_URL=https://webmail.byzand.online

# JWT
JWT_SECRET=change-this-to-random-64-char-string
JWT_REFRESH_SECRET=change-this-to-another-random-64-char-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# MongoDB
MONGODB_URI=mongodb://username:password@localhost:27017/bytemail

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# IMAP
IMAP_HOST=mail.byzand.online
IMAP_PORT=993
IMAP_TLS=true

# SMTP
SMTP_HOST=mail.byzand.online
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@byzand.online
SMTP_PASS=your-smtp-password
MAIL_FROM="ByteMail <noreply@byzand.online>"

# VAPID (PWA Push Notifications) - generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=admin@byzand.online
