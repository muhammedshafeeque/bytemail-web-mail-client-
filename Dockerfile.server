FROM node:20-alpine AS base
RUN apk add --no-cache dumb-init

FROM base AS deps
WORKDIR /app
COPY server/package*.json ./
RUN npm ci --only=production

FROM base AS builder
WORKDIR /app
COPY server/package*.json ./
RUN npm ci
COPY server/ .
RUN npm run build

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 bytemail
RUN mkdir -p logs uploads && chown -R bytemail:nodejs logs uploads
COPY --from=deps /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
USER bytemail
EXPOSE 3500
CMD ["dumb-init", "node", "dist/index.js"]
